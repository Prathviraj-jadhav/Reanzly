// High-frequency GPS pings from driver app (watchPosition)
model DriverLocationPing {
  id         String   @id @default(cuid())
  driverId   String
  driverName String?
  tripId     String?
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  heading    Float?
  altitude   Float?
  address    String?
  ignition   Boolean?
  battery    Int?
  createdAt  DateTime @default(now())

  @@index([driverId, createdAt])
