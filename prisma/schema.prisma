model BrokerLedgerEntry {
  id                String   @id @default(cuid())
  brokerProfileId   String
  entryId           String   @unique // led-XXX
  date              DateTime
  type              String   // Credit | Debit
  description       String
  refId             String
  amountINR         Float
  runningBalanceINR Float
  createdAt         DateTime @default(now())

  brokerProfile     BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)
}

// Reanzly's published rate card - the base rates brokers resell on.
model LaneRate {
  id            String   @id @default(cuid())
  laneId        String   @unique // ln-XXX
  lane          String
  origin        String
  destination   String
  distanceKm    Int
  baseRatePerKm Float
  vehicleTypes  String   @default("") // JSON array
  transitHours  Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== INTEGRATIONS MARKETPLACE =====
// Persisted connections for every external service (payment gateways, SMS,
// WhatsApp, 3PL, telematics, gov, fuel, banking, email, CRM, etc.).
// Secrets are stored encrypted in production (encrypt at app layer).
// `fieldValues` is a JSON blob of the provider's config fields.
// `companyId` enables tenant isolation. Reanzly internal team connections
// (PlatformUser scope) use a synthetic companyId of "PLATFORM".

model IntegrationConnection {
  id              String   @id @default(cuid())
  companyId       String   // tenant key, "PLATFORM" for Reanzly internal
  providerId      String   // e.g. "razorpay", "msg91", "google-maps"
  category        String   // payment | sms | whatsapp | extension | plugin | telemetry | identity | logistics | ecommerce | warehouse | maps | gov | fuel | banking
  label           String?  // user-supplied instance label (multi-instance)
  status          String   @default("connected") // connected | sandbox | needs-config | error
  mode            String   @default("live") // live | test
  priority        Int      @default(1) // 1 = highest, used for routing
  isPrimary       Boolean  @default(false)
  fieldValues     String   @default("{}") // JSON of field id → value (secrets masked)
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // ok | error | pending
  lastSyncMessage String?
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  webhooks        IntegrationWebhookLog[]
  syncLogs        IntegrationSyncLog[]

  @@index([companyId, category])
  @@index([companyId, status])
  @@index([providerId])
}

model IntegrationWebhookLog {
  id              String   @id @default(cuid())
  connectionId    String
  providerId      String
  eventType       String   // payment.captured, message.sent, etc.
  signature       String?
  payload         String   // raw JSON payload
  processed       Boolean  @default(false)
  processingError String?
  receivedAt      DateTime @default(now())

  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, receivedAt])
  @@index([providerId, receivedAt])
  @@index([processed])
}

// ============================================================
// IntegrationSyncLog — every DB sync run for a connection.
// Drives the "Sync history" drawer in the Integrations module.
// Triggered by the scheduler (real-time / hourly / daily / on-demand)
// or by a manual "Sync Now" click. Status transitions:
//   pending -> running -> ok | error | partial
// ============================================================
model IntegrationSyncLog {
  id              String   @id @default(cuid())
  connectionId    String
  providerId      String
  companyId       String   // tenant key
  syncType        String   // scheduled | manual | webhook-triggered
  status          String   @default("pending") // pending | running | ok | error | partial
  recordsPulled   Int      @default(0)
  recordsPushed   Int      @default(0)
  durationMs      Int      @default(0)
  errorMessage    String?
  errorDetails    String?  // JSON: stack / validation errors
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([providerId, startedAt])
  @@index([companyId, startedAt])
  @@index([status])
}

// ===== SLM SYSTEM =====

model SlmFeedback {
  id              String   @id @default(cuid())
  companyId       String   // tenant isolation
  userId          String?
  agentId         String
  query           String
  response        String
  rating          Int      // 1 to 5, or 1/-1 (thumbs up/down)
  comment         String?
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([companyId, agentId])
  @@index([processed])
}

model SlmMemory {
  id              String   @id @default(cuid())
  companyId       String   // tenant isolation
  userId          String?
  key             String
  value           String
  embedding       String?  // JSON string representing Float32Array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, key])
}

// Rean's knowledge base for retrieval-augmented generation: compliance rules,
// platform/module reference, and operating definitions - grounding facts
// distinct from SlmMemory (which holds per-conversation history/QA cache).
// Most content is shared across tenants (companyId = "global"); a specific
// company's own added knowledge can scope to their own companyId later.
model KnowledgeChunk {
  id          String   @id @default(cuid())
  companyId   String   @default("global")
  source      String   // e.g. "compliance", "platform-docs", "glossary"
  title       String
  content     String
  embedding   String?  // JSON string representing Float32Array
  createdAt   DateTime @default(now())

  @@index([companyId, source])
}

// Rean's database tool: real writes (create/update/delete via Rean) never
// execute immediately - they're proposed here, shown to the user for
// explicit confirmation in chat, and only executed once approved. This is
// the real, auditable version of "limited access... can't just go do
// stuff" - every write Rean ever makes has a row here proving what was
// proposed, by whom, when, and whether/when it was actually approved and run.
model RagAction {
  id            String   @id @default(cuid())
  companyId     String
  userId        String   // who Rean was acting on behalf of
  operation     String   // "create" | "update" | "delete"
  model         String   // Prisma model name the action targets, e.g. "Invoice"
  recordId      String?  // target row id, null for "create"
  argsJson      String   // JSON of the proposed Prisma args (where/data)
  summary       String   // human-readable one-line description shown in chat
  status        String   @default("pending") // pending | confirmed | executed | rejected | failed
  errorMessage  String?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?
  executedAt    DateTime?

  @@index([companyId, userId, status])
}

// Real audio/video calls, including scheduled ones. Signaling itself
// (SDP offer/answer, ICE candidates) is transient and flows over
// chat-service's socket.io - only call *records* (who, when, status) persist
// here, the same split as ChatMessage (content) vs. presence (transient).
model Call {
  id             String    @id @default(cuid())
  companyId      String
  conversationId String?   // the chat conversation this call is attached to, if any
  initiatorId    String
  type           String    // "audio" | "video"
  status         String    @default("scheduled") // scheduled | ringing | active | ended | missed | cancelled
  participantIds String    // JSON string array of userIds invited/joined
  scheduledFor   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([companyId, conversationId])
  @@index([initiatorId, status])
}

// Real model for the Quality module (previously no Prisma model - Zustand
// mock generation only). Findings/control points/corrective actions/
// activity are variable-shape nested collections tied 1:1 to their check,
// so - matching the documentsJson/assetsJson/argsJson precedent elsewhere
// in this schema rather than a SQLite Json column - they're stored as
// JSON-stringified columns and (de)serialized at the API DTO boundary.
model QualityCheck {
  id                    String   @id @default(cuid())
  companyId             String
  checkId               String   // human code, e.g. QC-00001
  type                  String   // Vehicle | Goods Receipt | Service | Document | Process Audit
  reference             String   // vehicle plate / GRN no / service order / document name / process name
  referenceEntity       String?  // cross-module entity id
  referenceModule       String?  // vehicles | drivers-staff | customers | vendors | warehouse
  inspector             String
  date                  DateTime
  result                String   // Pass | Fail | Conditional | Waived
  status                String   @default("Scheduled") // Scheduled | In Progress | Completed | Cancelled
  score                 Int      @default(0) // 0-100
  location              String?
  findingsJson          String?  // JSON: CheckFinding[]
  controlPointsJson     String?  // JSON: ControlPoint[]
  correctiveActionsJson String?  // JSON: CorrectiveAction[]
  activityJson          String?  // JSON: CheckActivity[]
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, type])
}

// Real model for the Purchase module (previously no Prisma model). Lines/
// receipts/bills/activity are nested collections with their own multi-field
// shape and no cross-module reuse, so - same rationale as QualityCheck
// above - they're JSON-stringified columns rather than separate line-item
// tables (this schema has no line-item precedent even for Invoice, which
// stores only aggregate amount/taxAmount/totalAmount).
model PurchaseOrder {
  id               String    @id @default(cuid())
  companyId        String
  poNumber         String
  vendorId         String?
  vendorName       String
  category         String
  poDate           DateTime
  expectedDelivery DateTime?
  deliveryLocation String?
  paymentTerms     String?
  buyer            String?
  status           String    @default("Draft")
  subtotal         Int       @default(0) // paise
  taxTotal         Int       @default(0) // paise
  total            Int       @default(0) // paise
  notes            String?
  linesJson        String?   // JSON: POLine[]
  receiptsJson     String?   // JSON: POReceipt[]
  billsJson        String?   // JSON: POBill[]
  activityJson     String?   // JSON: POActivity[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, poNumber])
  @@index([companyId, status])
}

// ===== VENDOR PORTAL (customer self-service) =====
// The Vendor Portal's Overview/Analytics/Shipments/Tracking/Invoices/PODs/
// Documents/Profile tabs are all real projections of Trip/Invoice/Pod/
// Document/Customer, scoped via Customer.userId - no new models needed for
// those. Ledger, RFQ and Support genuinely have no existing model to reuse:

// Non-invoice ledger movements (payments, credit/debit notes, opening
// balance). Invoice-type ledger rows are NOT duplicated here - the ledger
// API composes real Invoice rows (as debit entries) with these rows, sorted
// by date, to compute a running balance - matching the "don't duplicate
// data that already exists in another real table" precedent elsewhere in
// this schema (e.g. Pod.consignmentNumber only denormalizes when there's no
// resolvable LR, PurchaseOrder has no separate line-item table).
model LedgerEntry {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  invoiceId   String?
  type        String   // Payment | CreditNote | DebitNote | OpeningBalance
  description String
  // Rupees, not paise - Invoice/Customer (the two real models the ledger
  // composes these rows alongside) store their amounts directly in rupees
  // too, so this matches rather than following the Expense/PurchaseOrder
  // paise convention used elsewhere in this schema.
  debit       Int      @default(0)
  credit      Int      @default(0)
  date        DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())

  @@index([companyId, customerId, date])
}

// A freight rate request the logistics company issues to a customer's lane,
// which the customer (via the Vendor Portal) can quote back on.
model Rfq {
  id              String    @id @default(cuid())
  companyId       String
  customerId      String
  rfqNumber       String
  lane            String
  origin          String
  destination     String
  vehicleType     String
  weightKg        Float
  packages        Int
  distanceKm      Float?
  commodity       String
  requiredDate    DateTime
  receivedAt      DateTime  @default(now())
  expiresAt       DateTime?
  status          String    @default("Pending") // Pending | Quoted | Won | Lost | Expired
  quotedRatePerKm Float?
  validityDays    Int?
  quotedAt        DateTime?
  notes           String?
  issuedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, rfqNumber])
  @@index([companyId, customerId, status])
}

model SupportTicket {
  id           String   @id @default(cuid())
  companyId    String
  customerId   String
  ticketNumber String
  subject      String
  category     String
  priority     String   @default("Medium") // Low | Medium | High | Urgent
  status       String   @default("Open") // Open | Awaiting Reply | In Progress | Resolved | Closed
  linkedRef    String?
  description  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages     TicketMessage[]

  @@unique([companyId, ticketNumber])
  @@index([companyId, customerId, status])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromName  String
  fromRole  String        // customer | staff
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

// ===== OPERATIONS HUB (task board / sprints) =====
// Backs the Operations Hub kanban + reports (previously entirely client-side
// mock state seeded from mock-data.ts's TASKS array plus a deterministic
// hash-derived fake enrichment for sprint/checklist/comments/attachments).
// `assignee`/`createdBy`/comment `authorName` are free-text display names,
// matching the existing Issue.assignee/reportedBy convention in this schema
// rather than a formal User relation - not every assignee (e.g. a driver)
// has a User row.

model Sprint {
  id        String   @id @default(cuid())
  companyId String
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("Planned") // Planned | Active | Completed | Backlog
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]

  @@index([companyId])
}

model Task {
  id               String    @id @default(cuid())
  companyId        String
  title            String
  description      String?
  assignee         String
  priority         String    @default("Medium") // Urgent | High | Medium | Low
  department       String    @default("Operations")
  status           String    @default("Backlog") // Backlog | Planned | In Progress | Blocked | Under Review | Completed
  isRean           Boolean   @default(false)
  linkedEntityType String?   // Trip | Vehicle | Driver | Customer | Invoice
  linkedEntityId   String?
  linkedEntityName String?
  checklistJson    String?   // [{text,done}]
  subtasksJson     String?   // [{text,done}]
  sprintId         String?
  sprint           Sprint?   @relation(fields: [sprintId], references: [id])
  dueDate          DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([companyId, status])
  @@index([companyId, sprintId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id             String   @id @default(cuid())
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name           String
  bucket         String
  key            String
  size           Int
  mimeType       String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([taskId])
}

// ===== REPORTS =====
// The Reports module had no persistence at all - "Scheduled" and "Custom"
// reports were pure in-memory client state seeded from mock-data.ts on
// every load (lost on refresh), and the Report Library's data came from
// mock-data.ts arrays via a client-side switch rather than any DB query.

model ScheduledReport {
  id           String    @id @default(cuid())
  companyId    String
  reportId     String    // matches the static REPORT_TYPES catalog id, e.g. "trip-summary"
  reportName   String
  category     String
  frequency    String    // Daily | Weekly | Monthly
  deliveryTime String    // "HH:MM"
  recipients   String    // JSON string array
  format       String    // PDF | CSV | Excel
  status       String    @default("Active") // Active | Paused
  nextRun      DateTime?
  lastRun      DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
}

model CustomReport {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  baseReportId String    // matches REPORT_TYPES id
  category     String
  description  String?
  filters      String?   // JSON snapshot of the ReportConfigForm used to build it
  createdBy    String?
  createdAt    DateTime  @default(now())
  lastRun      DateTime?
  runCount     Int       @default(0)

  @@index([companyId])
}

// ===== FINANCIAL SERVICES =====
// Embedded-fintech demo module (invoice discounting / working capital /
// fuel card offers against the org's own real invoice/fleet data). The
// eligibility math already read real Invoice/Vehicle fields once this
// model existed to persist against - only the applications ledger itself
// was fake (a Zustand store persisted to browser localStorage, not shared
// across users/devices, not company-scoped, lost if localStorage was
// cleared). This module intentionally stays illustrative for the actual
// underwriting/disbursal decision (no real bureau or payment rail is
// wired in, per the standing no-third-party-integrations constraint) -
// only the record-keeping itself needed to become real.

model FinancingApplication {
  id                String    @id @default(cuid())
  companyId         String
  applicationNumber String    @unique
  productType       String    // Invoice Discounting | Working Capital Loan | Fuel Card Credit Line
  linkedInvoiceIds  String    @default("[]") // JSON array of real Invoice ids
  requestedAmount   Int       // rupees, matching Invoice.totalAmount's convention
  tenureMonths      Int
  status            String    @default("submitted") // draft | submitted | under_review | approved | disbursed | rejected
  notes             String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime? // set once status reaches approved | disbursed | rejected - powers a real avg-processing-time KPI

  @@index([companyId])
}

