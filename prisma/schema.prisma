// Garage Plus — Logistics Operating System
// Multi-tenant schema with RLS-style tenant isolation via companyId.
// All tables carry tenant key + audit fields. Append-only audit log.
//
// Architecture note (per the user's system-design brief):
// - One logical database, tenant isolation via companyId on every row.
// - Monolith-first: the Next.js app + Prisma + SQLite (swap to Postgres in
//   prod) handle 95% of the load. The only candidate for extraction to a
//   microservice is the GPS ingestion path (DriverLocationPing), which is
//   write-heavy + high-frequency — it can be split to a dedicated service
//   with its own queue + time-series store without touching the monolith.
// - Vertical scaling first (bigger box), horizontal when a single module
//   becomes the bottleneck (read-replicas for reports, sharding for trips).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== TENANCY =====

model Company {
  id          String   @id @default(cuid())
  legalName   String
  tradeName   String?
  gstin       String   @unique
  pan         String?
  address     String?
  city        String?
  state       String?
  pin         String?
  country     String   @default("India")
  phone       String?
  email       String?
  website     String?
  status      String   @default("Active") // Active | Inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  users       User[]
  vehicles    Vehicle[]
  drivers     Driver[]
  customers   Customer[]
  vendors     Vendor[]
  trips       Trip[]
  invoices    Invoice[]
  auditLogs   AuditLog[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  city      String?
  state     String?
  managerId String?
  status    String   @default("Active")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== IDENTITY & ACCESS =====

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  name         String
  role         String   @default("Staff") // Super Admin | Operations Manager | Fleet Manager | Finance Manager | Dispatcher | Driver | Analyst
  department   String?
  jobTitle     String?
  branchId     String?
  status       String   @default("Active") // Active | Inactive | On Leave
  phone        String?
  passwordHash String?
  salt         String?
  twoFactorEnabled Boolean @default(false)
  lastActive   DateTime?
  // Self-service profile fields (Settings > Profile) - real, user-editable,
  // distinct from the identity/auth fields above.
  altEmail         String?
  altPhone         String?
  dob              DateTime?
  gender           String?
  address          String?
  reportingManager String?
  language         String?
  timezone         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[] @relation("AuditActor")
  sessions     Session[]
  customer     Customer?
  brokerProfile BrokerProfile?
}

// Real, server-verified, revocable login sessions - an opaque random token
// stored server-side (not a signed JWT), so logout actually invalidates
// access immediately rather than just discarding a client-side value.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String   // JSON string of permission matrix
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== FLEET =====

model Vehicle {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  licensePlate    String   @unique
  vin             String?
  make            String?
  model           String?
  year            Int?
  type            String?
  group           String?
  status          String   @default("Idle") // Active | Idle | In Maintenance | Offline
  ownership       String   @default("Owned") // Owned | Leased | Attached
  fuelType        String   @default("Diesel")
  currentMeter    Int      @default(0)
  location        String?
  // Real, persisted fields matching the UI's existing Vehicle contract
  // (src/lib/types.ts) - previously only ever held in client-side state.
  operator        String?
  watchers        String   @default("[]") // JSON string array of userIds
  distanceThisPeriod Int   @default(0)
  assignedTripId  String?
  gpsSpeed        Float?
  lastGpsUpdate   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips           Trip[]
  fuelEntries     FuelEntry[]
  inspections     Inspection[]
  workOrders      WorkOrder[]
  documents       Document[]
  // Back-relations from the operational models (RateCard/LR/POD/Expense/Issue/Service/Reminder).
  expenses        Expense[]         @relation("VehicleExpenses")
  issues          Issue[]           @relation("VehicleIssues")
  servicePrograms ServiceProgram[]  @relation("VehicleServicePrograms")
  reminders       Reminder[]        @relation("VehicleReminders")
}

// ===== PEOPLE =====

model Driver {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String?
  phone           String?
  role            String   @default("Driver") // Driver | Staff
  department      String?
  status          String   @default("Active")
  licenseNumber   String?
  licenseExpiry   DateTime?
  rating          Float    @default(0)
  tripsCompleted  Int      @default(0)
  onTimeRate      Float    @default(0)
  city            String?
  // Real, persisted fields matching the UI's existing Driver contract
  // (src/lib/types.ts) - previously only ever held in client-side state.
  assignedVehicle String?
  lastActive      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips           Trip[]
  documents       Document[]
  // Back-relations: PODs captured by this driver, expenses & issues filed by them,
  // and the Employee record(s) when the driver is also on the HR payroll (a
  // driver may have multiple employment records over time, so one-to-many).
  pods            Pod[]     @relation("DriverPODs")
  expenses        Expense[] @relation("DriverExpenses")
  issues          Issue[]   @relation("DriverIssues")
  employees       Employee[]
  fuelEntries     FuelEntry[]
  inspections     Inspection[]
  reminders       Reminder[]
}

model Customer {
  id              String   @id @default(cuid())
  companyId       String
  companyName     String
  contactPerson   String?
  designation     String?
  phone           String?
  email           String?
  gstin           String?
  pan             String?
  legalEntity     String?
  city            String?
  state           String?
  pincode         String?
  billingAddress  String?
  status          String   @default("Active")
  paymentTerms    String?
  creditLimit     Int      @default(0)
  outstandingBalance Int   @default(0)
  accountManager  String?
  // Links this Customer to the real User who logs into the Vendor Portal
  // (src/components/layout/vendor-shell.tsx) as this company's self-service
  // contact - lets a real session resolve "which customer am I" instead of
  // the portal hardcoding a single demo customer for every viewer.
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  // CRM "Account" fields - the CRM module's Accounts tab is the same real
  // Customer record as the Customers module (both are now CRM-cluster
  // tabs), just presented with a CRM-flavoured column set. These fields
  // exist for that view only; revenueYTD/lastShipment stay computed live
  // from real Invoice/Trip relations rather than stored (same pattern as
  // Customer.activeTrips/totalRevenue elsewhere in this schema).
  crmType         String?  // Shipper | Consignee | Broker | 3PL
  lanes           String?  // comma-separated lane names
  contractStatus  String?  // Active | Under Renewal | Expired | None
  onboardingDate  DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips           Trip[]
  invoices        Invoice[]
  // CRM + Lorry-receipt back-relations — closes the customer → deal / LR loop.
  deals           Deal[]
  crmContacts     CrmContact[]
  crmActivities   CrmActivity[]
  rateCards       RateCard[]
  lorryReceipts   LorryReceipt[] @relation("CustomerLRs")
}

model Vendor {
  id              String   @id @default(cuid())
  companyId       String
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  gstin           String?
  city            String?
  type            String?
  status          String   @default("Active")
  paymentTerms    String?
  rating          Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ===== OPERATIONS =====

model Trip {
  id              String   @id @default(cuid())
  companyId       String
  tripId          String   @unique
  lrNumber        String   @unique
  customerId      String?
  vehicleId       String?
  driverId        String?
  consignor       String
  consignee       String
  origin          String
  destination     String
  status          String   @default("Planned") // Planned | Active | In Transit | Delivered | Cancelled | Breakdown
  orderMode       String   @default("FTL") // FTL | LTL | Part Load
  freightAmount   Int      @default(0)
  paymentStatus   String   @default("Unpaid") // Unpaid | Partially Paid | Paid | Overdue
  distanceKm      Int      @default(0)
  eWayBill        String?
  createdDate     DateTime @default(now())
  expectedDelivery DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  driver          Driver?  @relation(fields: [driverId], references: [id])
  invoices        Invoice[]
  // Operational back-relations: the rate card applied, LRs raised, POD captured,
  // expenses incurred, and issues filed against this trip.
  rateCards       RateCard[]     @relation("TripRateCard")
  lorryReceipts   LorryReceipt[] @relation("TripLRs")
  pods            Pod[]          @relation("TripPOD")
  expenses        Expense[]      @relation("TripExpenses")
  issues          Issue[]        @relation("TripIssues")
}

// ===== FINANCE =====

model Invoice {
  id              String   @id @default(cuid())
  companyId       String
  invoiceNumber   String   @unique
  customerId      String?
  tripId          String?
  customer        String
  amount          Int      @default(0)
  taxAmount       Int      @default(0)
  totalAmount     Int      @default(0)
  status          String   @default("Draft") // Draft | Sent | Partially Paid | Paid | Overdue | Cancelled | Credit Note
  paymentStatus   String   @default("Unpaid")
  invoiceDate     DateTime @default(now())
  dueDate         DateTime?
  igst            Int?
  cgst            Int?
  sgst            Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer_rel    Customer? @relation(fields: [customerId], references: [id])
  trip            Trip?    @relation(fields: [tripId], references: [id])
}

model FuelEntry {
  id              String   @id @default(cuid())
  companyId       String
  vehicleId       String?
  driverId        String?
  fuelType        String   @default("Diesel")
  date            DateTime @default(now())
  quantity        Float
  unitPrice       Float
  totalCost       Int
  odometer        Int
  efficiency      Float?
  station         String?
  anomaly         Boolean  @default(false)
  anomalyNote     String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  driver          Driver?  @relation(fields: [driverId], references: [id])
  createdAt       DateTime @default(now())
}

model Inspection {
  id              String   @id @default(cuid())
  companyId       String
  inspectionId    String   @unique
  vehicleId       String?
  driverId        String?
  type            String
  inspector       String
  date            DateTime @default(now())
  result          String   // Pass | Fail | Conditional
  odometer        Int      @default(0)
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  driver          Driver?  @relation(fields: [driverId], references: [id])
  createdAt       DateTime @default(now())
}

model WorkOrder {
  id              String   @id @default(cuid())
  companyId       String
  workOrderId     String   @unique
  vehicleId       String?
  title           String
  type            String   // Scheduled | Unscheduled | Recall | Warranty
  priority        String   // Urgent | High | Medium | Low
  status          String   @default("Open") // Open | In Progress | Completed | Cancelled
  vendor          String?
  technician      String?
  estimatedCost   Int      @default(0)
  actualCost      Int?
  createdDate     DateTime @default(now())
  estimatedCompletion DateTime?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== COMPLIANCE =====

model Document {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  type            String
  entityType      String   // Vehicle | Driver | Customer | Vendor | Company
  entityId        String?
  vehicleId       String?
  driverId        String?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          String   @default("Valid") // Valid | Expiring Soon | Expired
  uploadedBy      String?
  uploadDate      DateTime @default(now())
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  driver          Driver?  @relation(fields: [driverId], references: [id])
  createdAt       DateTime @default(now())
}

// ===== AUDIT (append-only, immutable) =====

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT
  entity    String
  entityId  String?
  oldValue  String?  // JSON
  newValue  String?  // JSON
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ===== AUTOMATION =====
// `Automation` already existed in the schema but had zero consumers - no
// companyId (added below), no API routes, nothing in src/ ever queried it.
// The Automation module UI read entirely from mock-data.ts's AUTOMATIONS
// array instead. AutomationRunLog is new, modeled on IntegrationSyncLog's
// shape (the closest existing real "execution history" pattern) since no
// run-history concept existed for automations at all.

model Automation {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  trigger     String
  triggerCategory String
  conditions  String   // JSON
  actions     String   // JSON
  status      String   @default("Active") // Active | Paused
  lastRun     DateTime?
  runCount    Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Recurring execution ("loop") - a real, durable schedule powered by the
  // existing SQLite job queue (src/lib/queue), not a fake cron label. Each
  // run re-enqueues the next occurrence via a "automation.run" job.
  scheduleEnabled         Boolean   @default(false)
  scheduleIntervalMinutes Int?
  nextRunAt               DateTime?

  runLogs     AutomationRunLog[]

  @@index([companyId])
}

model AutomationRunLog {
  id                  String     @id @default(cuid())
  companyId           String
  automationId        String
  automation          Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationName      String     // denormalized snapshot - survives automation rename/delete
  triggerEntity       String?    // human label of what matched, e.g. "Invoice RZ-INV-02147" or "3 invoices matched"
  conditionsEvaluated String?
  result              String     // Success | Failed | Unsupported
  error               String?
  notes               String?    // real Rean-generated analysis text, when the "Trigger Rean Analysis" action ran
  matchedCount        Int        @default(0)
  durationMs          Int
  createdAt           DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([automationId])
}

// ===== DRIVER FIELD APP =====
// Append-only activity log (POD, fuel, expense, issue, inspection, status, notes, duty)
model DriverActivity {
  id            String   @id @default(cuid())
  driverId      String
  driverName    String?
  tripId        String?
  vehicleId     String?
  type          String   // STATUS_UPDATE | FUEL_LOG | EXPENSE | ISSUE | INSPECTION | POD | CHECK_IN | CHECK_OUT | NOTE
  payload       String   // JSON blob (type-specific fields)
  photoDataUrl  String?  // downsampled base64 JPEG (capped ~2MB)
  lat           Float?
  lng           Float?
  accuracy      Float?
  address       String?
  note          String?
  synced        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([driverId, createdAt])
  @@index([type, createdAt])
}

// High-frequency GPS pings from driver app (watchPosition)
model DriverLocationPing {
  id          String   @id @default(cuid())
  driverId    String
  driverName  String?
  tripId      String?
  lat         Float
  lng         Float
  accuracy    Float?
  speed       Float?
  heading     Float?
  altitude    Float?
  address     String?
  ignition    Boolean?
  battery     Int?
  createdAt   DateTime @default(now())

  @@index([driverId, createdAt])
}

// ===== JOB QUEUE =====
// Durable, retryable async jobs (photo processing, location batching,
// notification dispatch, report generation, audit logging, cache invalidation).
// Survives server restarts. Polled by in-process workers; swap to Redis/SQS in prod.
model Job {
  id           String    @id
  type         String    // photo.process | location.batch | notification.dispatch | report.generate | audit.log | cache.invalidate
  payload      String    // JSON
  status       String    @default("pending") // pending | running | completed | failed | dead
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  priority     Int       @default(0)
  runAfter     DateTime  @default(now())
  lockedBy     String?
  error        String?
  result       String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, runAfter, priority])
  @@index([type, status])
}

// ════════════════════════════════════════════════════════════════
// PLATFORM LAYER (Superadmin / multi-tenant control plane)
// admin.garageplus.com — Garage Plus internal team. These models live
// OUTSIDE the tenant boundary: they govern the tenants themselves.
// ════════════════════════════════════════════════════════════════

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique // starter | growth | enterprise
  name         String
  priceMonthly Int      // paise
  priceAnnual  Int      // paise
  vehicleCap   Int
  userCap      Int
  storageMb    Int
  features     String   // JSON array of module ids
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id           String   @id @default(cuid())
  companyId    String   @unique
  planId       String
  status       String   @default("Active") // Active | Trial | Suspended | Cancelled
  billingCycle String   @default("monthly") // monthly | annual
  startedAt    DateTime @default(now())
  renewsAt     DateTime?
  mrr          Int      // monthly recurring revenue in paise
  plan         Plan     @relation(fields: [planId], references: [id])
  invoices     PlatformInvoice[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A tenant's saved card, referenced only by its safe display attributes -
// brand/last 4 digits/expiry/holder name. Deliberately never stores a full
// card number or CVV (that would require real PCI-DSS-compliant tokenized
// vault infrastructure and a real payment gateway integration, out of
// scope per the standing "don't touch third-party API keys" constraint).
// This models "a card is on file for this org", the same safe pattern
// every real billing UI displays, without processing any real payment.
model PaymentMethod {
  id          String   @id @default(cuid())
  companyId   String
  brand       String   // Visa | Mastercard | Amex | RuPay
  last4       String
  expMonth    Int
  expYear     Int
  holderName  String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model PlatformInvoice {
  id             String   @id @default(cuid())
  subscriptionId String
  amount         Int      // paise
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("Pending") // Paid | Pending | Failed
  paidAt         DateTime?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
}

model PlatformUser {
  // Garage Plus internal staff (not tenant users — those are in User).
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String   @default("staff") // staff | billing | support | superadmin
  status     String   @default("Active")
  twoFactor  Boolean  @default(false)
  lastActive DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditEvents PlatformAuditLog[]
}

model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     PlatformUser? @relation(fields: [actorId], references: [id])
  action    String   // tenant.onboard | tenant.suspend | user.invite | backup.run …
  target    String?  // companyId / userId / backupId
  meta      String?  // JSON
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action, createdAt])
}

// ════════════════════════════════════════════════════════════════
// OFFLINE-FIRST SYNC + BACKUPS
// Every mutation a user makes offline is queued here and flushed when
// connectivity returns. The superadmin "Offline Sync Health" view monitors
// this table across tenants.
// ════════════════════════════════════════════════════════════════

model SyncQueueItem {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  device     String?  // device fingerprint / label
  type       String   // pod.create | fuel.create | trip.update | expense.create …
  module     String
  payload    String   // JSON — the mutation body
  status     String   @default("pending") // pending | syncing | failed | applied
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  appliedAt  DateTime?

  @@index([companyId, status])
  @@index([status, createdAt])
}

model ConflictRecord {
  // Same record edited on two devices while offline — needs manual resolution.
  id          String   @id @default(cuid())
  companyId   String
  module      String
  recordId    String
  deviceA     String
  deviceB     String
  payloadA    String   // JSON
  payloadB    String   // JSON
  resolvedAt  DateTime?
  resolution  String?  // JSON of the merged record
  createdAt   DateTime @default(now())

  @@index([companyId, resolvedAt])
}

model BackupSnapshot {
  id         String   @id @default(cuid())
  companyId  String
  label      String
  type       String   @default("Full") // Full | Incremental
  sizeBytes  Int
  storeKeys  String   // JSON array of localStorage/store keys snapshotted
  status     String   @default("Completed") // Running | Completed | Failed
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}

// ════════════════════════════════════════════════════════════════
// CRM — Customer Relationship Management
// Connects to Customer (Account = enriched customer view) + Trip + Invoice.
// ════════════════════════════════════════════════════════════════

model Lead {
  id          String   @id @default(cuid())
  leadId      String   @unique // display code, e.g. RZ-LEAD-1001
  companyId   String
  name        String
  company     String?  // lead's organisation (free text until converted)
  email       String?
  phone       String?
  city        String?
  source      String   // Inbound | Referral | ColdCall | Exhibition | Website
  laneInterest String?
  status      String   @default("New") // New | Contacted | Qualified | Converted | Lost
  score       Int      @default(0) // 0-100
  ownerId     String?  // assigned sales rep (free-text name)
  nextFollowUp DateTime?
  notes       String?
  // The deal this lead was converted into (back-relation only — the FK lives
  // on Deal.leadId so a lead can exist before conversion without a dangling id).
  deal        Deal?    @relation("LeadToDeal")
  activities  CrmActivity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status])
  @@index([ownerId])
}

model Deal {
  id           String   @id @default(cuid())
  dealId       String   @unique // display code, e.g. RZ-DEAL-1001
  companyId    String
  name         String   // shown to users as "title"
  company      String?  // free-text org name until tied to a real Customer
  customerId   String?  // FK to Customer once the deal is tied to an account
  customer     Customer? @relation(fields: [customerId], references: [id])
  contactId    String?
  contact      CrmContact? @relation(fields: [contactId], references: [id])
  leadId       String?  @unique
  lead         Lead?    @relation("LeadToDeal", fields: [leadId], references: [id])
  lane         String?
  value        Int      // paise
  stage        String   @default("New Lead") // matches the CRM UI's real vocabulary: New Lead | Qualified | Quotation Sent | Negotiation | Won | Lost
  probability  Int      @default(10) // %
  expectedClose DateTime?
  ownerId      String?
  wonAt        DateTime?
  lostReason   String?
  winReason    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities   CrmActivity[]

  @@index([companyId, stage])
  @@index([customerId])
}

model CrmContact {
  id          String   @id @default(cuid())
  contactId   String   @unique // display code, e.g. RZ-CONTACT-1001
  companyId   String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  name        String
  title       String?
  email       String?
  phone       String?
  city        String?
  linkedIn    String?
  decisionMaker Boolean @default(false)
  lastContactedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  CrmActivity[]
  deals       Deal[]

  @@index([companyId, customerId])
}

model CrmActivity {
  id          String   @id @default(cuid())
  activityId  String   @unique // display code, e.g. RZ-ACT-1001
  companyId   String
  type        String   // Call | Email | Meeting | SiteVisit | FollowUp | Quotation | Note
  title       String
  description String?
  ownerId     String?
  durationMinutes Int?
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  outcome     String?
  nextStep    String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([companyId, type, createdAt])
  @@index([leadId])
  @@index([dealId])
}

// ════════════════════════════════════════════════════════════════
// HR — Human Resources
// Driver exists separately (fleet-specific); Employee covers ALL staff
// (drivers, helpers, mechanics, dispatchers, office). An Employee can
// link to a Driver record when the person is a driver.
// ════════════════════════════════════════════════════════════════

model Employee {
  id            String   @id @default(cuid())
  companyId     String
  code          String   // employee code
  name          String
  designation   String   // Driver | Helper | Mechanic | Dispatcher | Accountant | BranchManager | HRExec | …
  department    String?
  branchId      String?
  branchName    String?  // free-text branch label the UI already worked with
  employmentType String  @default("Permanent") // Permanent | Contract | Daily
  doj           DateTime
  status        String   @default("Active") // matches the HR UI's real vocabulary: Active | On Leave | Notice | Exited
  exitDate      DateTime?
  ctcAnnual     Int      // paise
  esiEnrolled   Boolean  @default(false)
  pfEnrolled    Boolean  @default(false)
  uan           String?  // PF UAN
  esiNumber     String?
  pan           String?
  aadhaar       String?
  bankName      String?
  bankAccount   String?
  bankIfsc      String?
  driverId      String?  // link to Driver when the employee is a driver
  driver        Driver?  @relation(fields: [driverId], references: [id])
  // Profile - real fields the UI already collects, previously discarded
  phone         String?
  email         String?
  city          String?
  gender        String?
  dob           DateTime?
  bloodGroup    String?
  address       String?
  emergencyContact String?
  basicMonthly  Int?     // paise
  hraMonthly    Int?     // paise
  reportingTo   String?
  managerId     String?
  buddy         String?
  probationEndDate DateTime?
  confirmDate   DateTime?
  lastIncrementDate DateTime?
  lastIncrementPct Float?
  lastRating    String?
  skills        String?  // comma-separated
  // JSON-serialized arrays (documents/assets are lightweight per-employee
  // lists, not independently queried elsewhere - a real Prisma relation
  // would be overkill; stored as real JSON text, not discarded).
  documentsJson String?
  assetsJson    String?
  leaveBalanceCl Int     @default(12)
  leaveBalanceSl Int     @default(12)
  leaveBalancePl Int     @default(15)
  leaveBalanceMl Int     @default(0)
  structureId   String?  // salary structure this employee is paid under
  structure     SalaryStructure? @relation(fields: [structureId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendance    AttendanceRecord[]
  leaveRequests LeaveRequest[]
  payslips      Payslip[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([designation])
}

// Standalone Payroll module's pay-grade template - one row per grade
// (e.g. "Driver (Permanent)"), many Employees reference it via
// structureId. Real percentages/flags drive real payslip computation
// (see POST /api/payroll/cycles), not a scripted mock figure.
model SalaryStructure {
  id               String   @id @default(cuid())
  companyId        String
  name             String   // e.g. "Driver (Permanent)"
  department       String?
  ctcAnnual        Int      // paise
  basicPct         Int      // % of CTC
  daPct            Int      @default(0)
  hraPct           Int
  specialAllowance Int      @default(0) // paise, monthly
  conveyance       Int      @default(0)
  medicalAllowance Int      @default(0)
  statutoryBonus   Int      @default(0)
  pfPct            Int      @default(12)
  esiApplicable    Boolean  @default(false)
  ptApplicable     Boolean  @default(true)
  tdsApplicable    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employees        Employee[]

  @@index([companyId])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  mark        String   // P | A | H | L | W | T (Present/Absent/Half/Leave/Weekoff/Trip)
  inTime      DateTime?
  outTime     DateTime?
  overtimeHrs Int      @default(0)
  lateIn      Boolean  @default(false)
  earlyOut    Boolean  @default(false)
  tripId      String?  // trip-linked attendance for drivers
  createdAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@index([companyId, date])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String   // CL | SL | PL | ML
  fromDate   DateTime
  toDate     DateTime
  days       Int
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected
  approverId String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([companyId, status])
  @@index([employeeId])
}

model PayrollRun {
  id         String   @id @default(cuid())
  cycleNo    String   @unique // display code, e.g. RZ-CYC-1001
  companyId  String
  month      String   // YYYY-MM
  status     String   @default("Draft") // Draft | Processing | Approved | Disbursed | Cancelled
  locked     Boolean  @default(false)
  grossTotal Int      // paise
  deductTotal Int
  netTotal   Int
  employerContribTotal Int @default(0)
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?
  runBy      String?
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payslips   Payslip[]

  @@unique([companyId, month])
}

model Payslip {
  id          String   @id @default(cuid())
  payslipNo   String   @unique // display code, e.g. RZ-PAY-1001
  companyId   String
  payrollRunId String?
  payrollRun  PayrollRun? @relation(fields: [payrollRunId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String   // YYYY-MM
  basic       Int
  da          Int      @default(0)
  hra         Int
  conveyance  Int
  medicalAllowance Int @default(0)
  specialAllowance Int @default(0)
  statutoryBonus Int   @default(0)
  allowances  Int
  overtime    Int
  incentives  Int
  pfDeduct    Int
  esiDeduct   Int
  ptDeduct    Int
  tdsDeduct   Int
  advanceDeduct Int
  otherDeduct Int      @default(0)
  employerPF  Int      @default(0)
  employerESI Int      @default(0)
  presentDays Int      @default(0)
  lopDays     Int      @default(0)
  netPay      Int
  status      String   @default("Draft") // Draft | Approved | Paid | Hold
  createdAt   DateTime @default(now())

  @@index([companyId, month])
  @@index([employeeId])
}

model HrPosition {
  id         String   @id @default(cuid())
  positionId String   @unique // display code, e.g. RZ-POS-1001
  companyId  String
  title      String
  branchId   String?  // free-text branch label
  description String?
  openings   Int      @default(1)
  budgetMin  Int
  budgetMax  Int
  hiringManagerId String?
  status     String   @default("Open") // matches the HR UI's real vocabulary: Open | On Hold | Closed
  postedAt   DateTime @default(now())
  closedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidates Candidate[]

  @@index([companyId, status])
}

model Candidate {
  id          String   @id @default(cuid())
  companyId   String
  positionId  String
  position    HrPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  experience  Int?
  currentCtc  Int?
  expectedCtc Int?
  source      String?
  stage       String   @default("Applied") // Applied | Screening | Interview | Offer | Joined | Rejected
  rating      Int?
  notes       String?
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([positionId, stage])
}

// ════════════════════════════════════════════════════════════════
// OPERATIONAL MODELS — connect the existing fleet/finance entities.
// These close the loop: RateCard → Customer + Trip; LorryReceipt →
// Trip + Customer; POD → Trip + Driver; Expense → Trip + Vehicle;
// Issue → Vehicle + Driver; ServiceProgram → Vehicle.
// ════════════════════════════════════════════════════════════════

model RateCard {
  id          String   @id @default(cuid())
  companyId   String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  name        String
  laneFrom    String
  laneTo      String
  vehicleType String
  ratePerKm   Int      // paise
  minCharge   Int
  loadingChg  Int      @default(0)
  unloadingChg Int     @default(0)
  validFrom   DateTime
  validTo     DateTime?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trips       Trip[]   @relation("TripRateCard")

  @@index([companyId, customerId])
  @@index([laneFrom, laneTo])
}

model LorryReceipt {
  id          String   @id @default(cuid())
  companyId   String
  lrNumber    String
  tripId      String?
  trip        Trip?    @relation("TripLRs", fields: [tripId], references: [id])
  customerId  String?
  customer    Customer? @relation("CustomerLRs", fields: [customerId], references: [id])
  fromCity    String
  toCity      String
  consignor   String
  consignee   String
  goodsDesc   String?
  weightKg    Int?
  packages    Int?
  freight     Int      // paise
  freightTerm String   @default("To Pay") // Paid | To Be Billed | To Pay - matches the LR module UI's FreightTerm type
  eWayBillNo  String?
  eWayBillExpiry DateTime?
  status      String   @default("Generated") // Generated | Printed | Sent | Archived - matches the LR module UI's status type
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pod         Pod?     @relation("LRPOD")

  @@unique([companyId, lrNumber])
  @@index([companyId, status])
  @@index([tripId])
}

// Real model for the module's ProofOfDelivery UI concept (formerly Zustand
// + localStorage in pod-store.ts). One row per POD voucher; lrId links to a
// real LorryReceipt when the captured consignment number resolves to one,
// but consignmentNumber/source/destination/consignee/consignor are kept as
// their own denormalized fields since the field capture flow (driver's
// mobile POD form) always has them at hand and shouldn't require a strict
// LR join to save a draft.
model Pod {
  id                 String    @id @default(cuid())
  companyId          String
  lrId               String?   @unique
  lr                 LorryReceipt? @relation("LRPOD", fields: [lrId], references: [id])
  tripId             String?
  trip               Trip?     @relation("TripPOD", fields: [tripId], references: [id])
  driverId           String?
  driver             Driver?   @relation("DriverPODs", fields: [driverId], references: [id])

  voucherNumber      String
  consignmentNumber  String
  type               String    @default("Delivery") // Delivery | Pickup | Return
  source             String
  destination        String
  consignee          String
  consignor          String
  consignmentDate    DateTime
  loadingDate        DateTime

  frontImageFull     String?
  frontImageThumb    String?
  frontImageBytes    Int?
  backImageFull      String?
  backImageThumb     String?
  backImageBytes     Int?
  signatureImageFull String?
  signatureImageThumb String?
  signatureImageBytes Int?
  stampImageFull     String?
  stampImageThumb    String?
  stampImageBytes    Int?
  signatureDrawn     String?

  receivingDate      DateTime?
  reportingDate      DateTime?
  unloadingDate      DateTime?
  weight             Float?
  packages           Int?

  status             String    @default("Pending") // Delivered | Pending | Rejected | Damaged
  reportNumber       String
  submissionStatus   String    @default("Draft") // Draft | Submitted | Approved
  deliveryDate       DateTime?

  contactPhone       String?
  contactEmail       String?
  contactRelation    String?

  startOdometer      Float?
  endOdometer        Float?
  distance           Float?
  remarks            String?
  unloadingCharges   Int?      // paise
  otherCharges       Int?      // paise
  vehicleNumber      String?
  vehicleHireNumber  String?

  receivedBy         String?   // receiver name at destination
  receivedAt         DateTime?
  signatureUrl        String?
  photoUrl            String?
  gpsLat              Float?
  gpsLng              Float?
  conditionOk         Boolean  @default(true)

  createdByName      String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditEntries       PodAuditEntry[]

  @@index([companyId, status])
}

model PodAuditEntry {
  id        String   @id @default(cuid())
  podId     String
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  user      String
  action    String

  @@index([podId])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  tripId      String?
  trip        Trip?    @relation("TripExpenses", fields: [tripId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation("VehicleExpenses", fields: [vehicleId], references: [id])
  driverId    String?
  driver      Driver?  @relation("DriverExpenses", fields: [driverId], references: [id])
  category    String   // Fuel | Toll | Repair | Loading | Unloading | DriverBhatta | Misc
  description String?
  amount      Int      // paise
  payMode     String   @default("Cash") // Cash | UPI | Card | Credit
  vendorName  String?
  invoiceNo   String?
  incurredAt  DateTime
  status      String   @default("Pending") // Pending | Approved | Reimbursed | Rejected
  approvedBy  String?
  submittedBy String?
  receiptStatus String @default("Missing") // Attached | Missing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status, incurredAt])
  @@index([tripId])
}

model Issue {
  id          String   @id @default(cuid())
  companyId   String
  issueId     String   @unique
  vehicleId   String?
  vehicle     Vehicle? @relation("VehicleIssues", fields: [vehicleId], references: [id])
  driverId    String?
  driver      Driver?  @relation("DriverIssues", fields: [driverId], references: [id])
  tripId      String?
  trip        Trip?    @relation("TripIssues", fields: [tripId], references: [id])
  category    String   // Breakdown | Accident | Tyre | Electrical | Document | Compliance
  severity    String   @default("Medium") // Low | Medium | High | Critical
  title       String
  description String?
  status      String   @default("Open") // Open | InProgress | Resolved | Closed
  reportedBy  String?
  assignee    String?
  source      String   @default("Manual") // Manual | Inspection | Rean | Fault Code
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status, severity])
  @@index([vehicleId])
}

model ServiceProgram {
  id           String   @id @default(cuid())
  companyId    String
  vehicleId    String
  vehicle      Vehicle  @relation("VehicleServicePrograms", fields: [vehicleId], references: [id])
  templateId   String?
  template     ServiceTemplate? @relation(fields: [templateId], references: [id])
  name         String
  type         String   // Preventive | Corrective | Predictive
  intervalKm   Int?
  intervalDays Int?
  lastDoneKm   Int?
  lastDoneAt   DateTime?
  nextDueKm    Int?
  nextDueAt    DateTime?
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vehicleId, status])
  @@index([templateId])
}

// The Services module UI's "ServiceProgram" concept is really a reusable
// TEMPLATE (generic vehicleType, a task checklist, a default vendor/cost
// estimate) applied to many vehicles - distinct from the per-vehicle
// ServiceProgram instance above (which tracks one vehicle's actual
// lastDoneKm/nextDueAt against its own odometer/calendar). "linkedVehicles"
// in the UI is the live count of ServiceProgram rows pointing at a template.
model ServiceTemplate {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  vehicleType      String
  serviceType      String
  triggerType      String   // Time | Distance | Both
  intervalValue    Int
  intervalUnit     String   // km | months
  tasksJson        String   // JSON: { id: string; text: string }[]
  defaultVendor    String?
  estDurationHours Float?
  estCostPaise     Int?
  status           String   @default("Active") // Active | Draft | Paused
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instances        ServiceProgram[]

  @@index([companyId, status])
}

model Reminder {
  id          String   @id @default(cuid())
  companyId   String
  vehicleId   String?
  vehicle     Vehicle? @relation("VehicleReminders", fields: [vehicleId], references: [id])
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id])
  title       String
  category    String   // Service | Fitness | Insurance | Permit | PUC | Licence | Tax | Custom
  dueDate     DateTime
  notifyDays  Int      @default(7)
  status      String   @default("Pending") // Pending | Done | Snoozed
  createdAt   DateTime @default(now())

  @@index([companyId, status, dueDate])
}

// ===== REAL-TIME CHAT =====
// Reanzly team chat - channels, DMs, threads, reactions, read receipts.
// Multi-tenant via companyId on conversations. The socket.io mini-service
// (mini-services/chat-service) reads/writes these tables directly via bun:sqlite
// for real-time event handling; the Next.js app uses Prisma for REST hydration.

model ChatConversation {
  id          String   @id @default(cuid())
  companyId   String   @default("reanzly")
  name        String
  type        String   // direct | group | channel
  description String?
  topic       String?
  private     Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([companyId, type])
}

model ChatParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  userName        String
  userRole        String
  userInitials    String   @default("")
  joinedAt        DateTime @default(now())
  lastReadAt      DateTime?
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  senderName      String
  senderRole      String
  text            String
  parentId        String?
  attachment      String?
  forwardedFrom   String?
  isRean          Boolean  @default(false)
  isPoll          String?
  isCommandResult Boolean  @default(false)
  pinned          Boolean  @default(false)
  // Soft-delete: deleted messages stay in place with a tombstone instead of
  // being hard-removed, so "This message was deleted" renders like
  // Teams/WhatsApp rather than the message just vanishing from history.
  deleted         Boolean  @default(false)
  edited          Boolean  @default(false)
  editedAt        DateTime?
  createdAt       DateTime @default(now())

  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions        ChatReaction[]
  readReceipts     ChatReadReceipt[]
  pollVotes        ChatPollVote[]

  @@index([conversationId, createdAt])
  @@index([parentId])
}

// One row per (message, user) - a user can change their poll vote, which
// upserts this row rather than creating a second one. Votes broadcast live
// via "poll:updated" so every participant sees results update in real time,
// instead of the previous local-only vote count that never left the browser
// that cast it.
model ChatPollVote {
  id          String   @id @default(cuid())
  messageId   String
  userId      String
  optionId    String
  createdAt   DateTime @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model ChatReaction {
  id          String   @id @default(cuid())
  messageId   String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model ChatReadReceipt {
  id          String   @id @default(cuid())
  messageId   String
  userId      String
  createdAt   DateTime @default(now())
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// ===== BROKER NETWORK =====
// Brokers resell Reanzly capacity. They have their own profile, manage
// sub-brokers, handle inbound load enquiries, send quotes on marketplace
// loads, and run settlement cycles with NACH payouts.

model BrokerProfile {
  id                String   @id @default(cuid())
  userId            String?  @unique // links this profile to the real logged-in broker User
  brokerCode        String   @unique // RZB-XXXXXX
  companyName       String
  contactName       String
  email             String   @unique
  phone             String
  gstin             String?
  markupPct         Float    @default(8.0)
  settlementCycle   String   @default("Fortnightly") // Weekly | Fortnightly | Monthly
  gstTreatment      String   @default("Forward Charge") // Forward Charge | Reverse Charge
  coverageLanes     String   @default("") // JSON array of lane strings
  status            String   @default("Active") // Active | Pending | Suspended
  parentBrokerId    String?  // if this broker was onboarded by another broker
  bankName          String?
  bankBranch        String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  nachUmr           String?  // NACH mandate registration number
  nextPayoutDate    DateTime?
  nextPayoutAmount  Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?    @relation(fields: [userId], references: [id])
  subBrokers        SubBroker[]
  enquiries         BrokerEnquiry[]
  quotes            BrokerQuote[]
  settlements       SettlementCycle[]
  ledgerEntries     BrokerLedgerEntry[]
}

model SubBroker {
  id                  String   @id @default(cuid())
  brokerProfileId     String
  name                String
  brokerCode          String   @unique // RZSB-XXX
  contactName         String
  email               String
  phone               String
  markupPct           Float    @default(5.0)
  coverageLanes       String   @default("") // JSON array
  settlementCycle     String   @default("Weekly")
  gstTreatment        String   @default("Forward Charge")
  gstin               String?
  status              String   @default("Pending") // Active | Pending | Suspended
  settlementsDueINR   Float    @default(0)
  onboardedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  brokerProfile       BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)
}

model BrokerEnquiry {
  id                String   @id @default(cuid())
  brokerProfileId   String
  enquiryId         String   @unique // enq-XXXX
  lane              String
  vehicleType       String
  weightTon         Float
  expectedRatePerKm Float
  customer          String
  pickupDate        DateTime
  status            String   @default("New") // New | Quoted | Won | Lost
  quotedRate        Float?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brokerProfile     BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)
}

model BrokerQuote {
  id                String   @id @default(cuid())
  brokerProfileId   String
  quoteId           String   @unique // qte-XXXXX
  loadId            String   // mkt-XXXXX (reference to marketplace load)
  lane              String
  vehicleType       String
  customer          String
  quotedRatePerKm   Float
  baseRatePerKm     Float
  markupPct         Float
  status            String   @default("Pending") // Pending | Accepted | Rejected | Expired
  quotedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  brokerProfile     BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)
}

model SettlementCycle {
  id                  String   @id @default(cuid())
  brokerProfileId     String
  cycleId             String   @unique // CYC-2025-XX
  periodStart         DateTime
  periodEnd           DateTime
  grossTrips          Int
  grossValueINR       Float
  commissionPct       Float    @default(8.0)
  commissionEarnedINR Float
  tdsPct              Float    @default(1.0)
  tdsDeductedINR      Float
  gstTreatment        String   @default("Forward Charge")
  netPayableINR       Float
  status              String   @default("Draft") // Draft | Approved | Paid
