// Garage Plus â€” Logistics Operating System
// Multi-tenant schema with RLS-style tenant isolation via companyId.
// All tables carry tenant key + audit fields. Append-only audit log.
//
// Architecture note (per the user's system-design brief):
// - One logical database, tenant isolation via companyId on every row.
// - Monolith-first: the Next.js app + Prisma + SQLite (swap to Postgres in
//   prod) handle 95% of the load. The only candidate for extraction to a
//   microservice is the GPS ingestion path (DriverLocationPing), which is
//   write-heavy + high-frequency â€” it can be split to a dedicated service
//   with its own queue + time-series store without touching the monolith.
// - Vertical scaling first (bigger box), horizontal when a single module
//   becomes the bottleneck (read-replicas for reports, sharding for trips).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== TENANCY =====

model Company {
  id        String   @id @default(cuid())
  legalName String
  tradeName String?
  gstin     String   @unique
  pan       String?
  address   String?
  city      String?
  state     String?
  pin       String?
  country   String   @default("India")
  phone     String?
  email     String?
  website   String?
  status    String   @default("Active") // Active | Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches          Branch[]
  users             User[]
  vehicles          Vehicle[]
  drivers           Driver[]
  customers         Customer[]
  vendors           Vendor[]
  trips             Trip[]
  invoices          Invoice[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  fieldServiceTasks FieldServiceTask[]
  knowledgeArticles KnowledgeArticle[]
  helpdeskTickets   HelpdeskTicket[]
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  city      String?
  state     String?
  managerId String?
  status    String   @default("Active")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== IDENTITY & ACCESS =====

model User {
  id               String    @id @default(cuid())
  companyId        String
  email            String    @unique
  name             String
  role             String    @default("Staff") // Super Admin | Operations Manager | Fleet Manager | Finance Manager | Dispatcher | Driver | Analyst
  department       String?
  jobTitle         String?
  branchId         String?
  status           String    @default("Active") // Active | Inactive | On Leave
  phone            String?
  passwordHash     String?
  salt             String?
  twoFactorEnabled Boolean   @default(false)
  lastActive       DateTime?
  // Self-service profile fields (Settings > Profile) - real, user-editable,
  // distinct from the identity/auth fields above.
  altEmail         String?
  altPhone         String?
  dob              DateTime?
  gender           String?
  address          String?
  reportingManager String?
  language         String?
  timezone         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]
  sessions      Session[]
  customer      Customer?
  brokerProfile BrokerProfile?
}

// Real, server-verified, revocable login sessions - an opaque random token
// stored server-side (not a signed JWT), so logout actually invalidates
// access immediately rather than just discarding a client-side value.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String // JSON string of permission matrix
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== FLEET =====

model Vehicle {
  id                 String    @id @default(cuid())
  companyId          String
  name               String
  licensePlate       String    @unique
  vin                String?
  make               String?
  model              String?
  year               Int?
  type               String?
  group              String?
  status             String    @default("Idle") // Active | Idle | In Maintenance | Offline
  ownership          String    @default("Owned") // Owned | Leased | Attached
  fuelType           String    @default("Diesel")
  currentMeter       Int       @default(0)
  location           String?
  // Real, persisted fields matching the UI's existing Vehicle contract
  // (src/lib/types.ts) - previously only ever held in client-side state.
  operator           String?
  watchers           String    @default("[]") // JSON string array of userIds
  distanceThisPeriod Int       @default(0)
  assignedTripId     String?
  gpsSpeed           Float?
  lastGpsUpdate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips             Trip[]
  fuelEntries       FuelEntry[]
  inspections       Inspection[]
  workOrders        WorkOrder[]
  documents         Document[]
  // Back-relations from the operational models (RateCard/LR/POD/Expense/Issue/Service/Reminder).
  expenses          Expense[]          @relation("VehicleExpenses")
  issues            Issue[]            @relation("VehicleIssues")
  servicePrograms   ServiceProgram[]   @relation("VehicleServicePrograms")
  reminders         Reminder[]         @relation("VehicleReminders")
  planningResources PlanningResource[]
}

// ===== PEOPLE =====

model Driver {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  email           String?
  phone           String?
  role            String    @default("Driver") // Driver | Staff
  department      String?
  status          String    @default("Active")
  licenseNumber   String?
  licenseExpiry   DateTime?
  rating          Float     @default(0)
  tripsCompleted  Int       @default(0)
  onTimeRate      Float     @default(0)
  city            String?
  // Real, persisted fields matching the UI's existing Driver contract
  // (src/lib/types.ts) - previously only ever held in client-side state.
  assignedVehicle String?
  lastActive      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips             Trip[]
  documents         Document[]
  // Back-relations: PODs captured by this driver, expenses & issues filed by them,
  // and the Employee record(s) when the driver is also on the HR payroll (a
  // driver may have multiple employment records over time, so one-to-many).
  pods              Pod[]              @relation("DriverPODs")
  expenses          Expense[]          @relation("DriverExpenses")
  issues            Issue[]            @relation("DriverIssues")
  employees         Employee[]
  fuelEntries       FuelEntry[]
  inspections       Inspection[]
  reminders         Reminder[]
  planningResources PlanningResource[]
}

model Customer {
  id                 String    @id @default(cuid())
  companyId          String
  companyName        String
  contactPerson      String?
  designation        String?
  phone              String?
  email              String?
  gstin              String?
  pan                String?
  legalEntity        String?
  city               String?
  state              String?
  pincode            String?
  billingAddress     String?
  status             String    @default("Active")
  paymentTerms       String?
  creditLimit        Int       @default(0)
  outstandingBalance Int       @default(0)
  accountManager     String?
  // Links this Customer to the real User who logs into the Vendor Portal
  // (src/components/layout/vendor-shell.tsx) as this company's self-service
  // contact - lets a real session resolve "which customer am I" instead of
  // the portal hardcoding a single demo customer for every viewer.
  userId             String?   @unique
  user               User?     @relation(fields: [userId], references: [id])
  // CRM "Account" fields - the CRM module's Accounts tab is the same real
  // Customer record as the Customers module (both are now CRM-cluster
  // tabs), just presented with a CRM-flavoured column set. These fields
  // exist for that view only; revenueYTD/lastShipment stay computed live
  // from real Invoice/Trip relations rather than stored (same pattern as
  // Customer.activeTrips/totalRevenue elsewhere in this schema).
  crmType            String? // Shipper | Consignee | Broker | 3PL
  lanes              String? // comma-separated lane names
  contractStatus     String? // Active | Under Renewal | Expired | None
  onboardingDate     DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips         Trip[]
  invoices      Invoice[]
  // CRM + Lorry-receipt back-relations â€” closes the customer â†’ deal / LR loop.
  deals         Deal[]
  crmContacts   CrmContact[]
  crmActivities CrmActivity[]
  rateCards     RateCard[]
  lorryReceipts LorryReceipt[] @relation("CustomerLRs")
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  companyName   String
  contactPerson String?
  phone         String?
  email         String?
  gstin         String?
  city          String?
  type          String?
  status        String   @default("Active")
  paymentTerms  String?
  rating        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ===== OPERATIONS =====

model Trip {
  id               String    @id @default(cuid())
  companyId        String
  tripId           String    @unique
  lrNumber         String    @unique
  customerId       String?
  vehicleId        String?
  driverId         String?
  consignor        String
  consignee        String
  origin           String
  destination      String
  status           String    @default("Planned") // Planned | Active | In Transit | Delivered | Cancelled | Breakdown
  orderMode        String    @default("FTL") // FTL | LTL | Part Load
  freightAmount    Int       @default(0)
  paymentStatus    String    @default("Unpaid") // Unpaid | Partially Paid | Paid | Overdue
  distanceKm       Int       @default(0)
  eWayBill         String?
  createdDate      DateTime  @default(now())
  expectedDelivery DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id])
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  invoices      Invoice[]
  // Operational back-relations: the rate card applied, LRs raised, POD captured,
  // expenses incurred, and issues filed against this trip.
  rateCards     RateCard[]     @relation("TripRateCard")
  lorryReceipts LorryReceipt[] @relation("TripLRs")
  pods          Pod[]          @relation("TripPOD")
  expenses      Expense[]      @relation("TripExpenses")
  issues        Issue[]        @relation("TripIssues")
}

// ===== FINANCE =====

model Invoice {
  id            String    @id @default(cuid())
  companyId     String
  invoiceNumber String    @unique
  customerId    String?
  tripId        String?
  customer      String
  amount        Int       @default(0)
  taxAmount     Int       @default(0)
  totalAmount   Int       @default(0)
  status        String    @default("Draft") // Draft | Sent | Partially Paid | Paid | Overdue | Cancelled | Credit Note
  paymentStatus String    @default("Unpaid")
  invoiceDate   DateTime  @default(now())
  dueDate       DateTime?
  igst          Int?
  cgst          Int?
  sgst          Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer_rel Customer? @relation(fields: [customerId], references: [id])
  trip         Trip?     @relation(fields: [tripId], references: [id])
}

model FuelEntry {
  id          String   @id @default(cuid())
  companyId   String
  vehicleId   String?
  driverId    String?
  fuelType    String   @default("Diesel")
  date        DateTime @default(now())
  quantity    Float
  unitPrice   Float
  totalCost   Int
  odometer    Int
  efficiency  Float?
  station     String?
  anomaly     Boolean  @default(false)
  anomalyNote String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  driver      Driver?  @relation(fields: [driverId], references: [id])
  createdAt   DateTime @default(now())
}

model Inspection {
  id           String   @id @default(cuid())
  companyId    String
  inspectionId String   @unique
  vehicleId    String?
  driverId     String?
  type         String
  inspector    String
  date         DateTime @default(now())
  result       String // Pass | Fail | Conditional
  odometer     Int      @default(0)
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  driver       Driver?  @relation(fields: [driverId], references: [id])
  createdAt    DateTime @default(now())
}

model WorkOrder {
  id                  String    @id @default(cuid())
  companyId           String
  workOrderId         String    @unique
  vehicleId           String?
  title               String
  type                String // Scheduled | Unscheduled | Recall | Warranty
  priority            String // Urgent | High | Medium | Low
  status              String    @default("Open") // Open | In Progress | Completed | Cancelled
  vendor              String?
  technician          String?
  estimatedCost       Int       @default(0)
  actualCost          Int?
  createdDate         DateTime  @default(now())
  estimatedCompletion DateTime?
  vehicle             Vehicle?  @relation(fields: [vehicleId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ===== COMPLIANCE =====

model Document {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  type       String
  entityType String // Vehicle | Driver | Customer | Vendor | Company
  entityId   String?
  vehicleId  String?
  driverId   String?
  issueDate  DateTime?
  expiryDate DateTime?
  status     String    @default("Valid") // Valid | Expiring Soon | Expired
  uploadedBy String?
  uploadDate DateTime  @default(now())
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver     Driver?   @relation(fields: [driverId], references: [id])
  createdAt  DateTime  @default(now())
}

// ===== AUDIT (append-only, immutable) =====

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT
  entity    String
  entityId  String?
  oldValue  String? // JSON
  newValue  String? // JSON
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ===== NOTIFICATIONS (real, per-user, real trigger points) =====
// Replaces the client-only mock-data.ts NOTIFICATIONS array. Written by
// src/lib/notify.ts from real mutation routes (HR approvals, Automation
// runs) and a real recurring alert-scan job (overdue invoices), read by
// GET /api/notifications for the signed-in user.
model Notification {
  id          String   @id @default(cuid())
  companyId   String
  userId      String // recipient
  category    String // Compliance | Invoice | Trip | Vehicle | Payment | HR | Automation | Rean
  severity    String   @default("info") // critical | warning | info
  title       String
  description String?
  linkModule  String?
  linkId      String?
  dedupeKey   String? // stable key for idempotent alert-scan jobs, e.g. "overdue-invoice:{invoiceId}"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([dedupeKey])
}

// ===== FIELD SERVICE =====
// Replaces the Field Service module's entirely client-only state: the old
// FIELD_TASKS mock array lived only in FieldServiceModule's useState, and
// TaskDetail separately re-derived its own record by searching that same
// static array by id - so a task created via AddTaskDrawer was invisible
// the moment you clicked into it ("not found"), and every action on the
// detail page (status change, checklist, parts, time entries, signature)
// mutated a local copy that vanished on navigation. checklist/parts/
// timeEntries are stored as JSON (per-task nested lists, never queried
// independently across tasks) - same convention as Employee.documentsJson/
// assetsJson elsewhere in this schema.
model FieldServiceTask {
  id                String    @id @default(cuid())
  companyId         String
  taskId            String    @unique // display code, e.g. FS-4001
  title             String
  type              String // Repair | Inspection | Survey | Installation | Maintenance
  customerId        String?
  customer          String
  customerCode      String?
  technician        String
  scheduledAt       DateTime
  completedAt       DateTime?
  status            String    @default("Scheduled") // Scheduled | Assigned | En Route | In Progress | Completed | Cancelled
  priority          String    @default("Medium") // Urgent | High | Medium | Low
  location          String
  locationLat       Float?
  locationLng       Float?
  vehicleRef        String?
  contactName       String
  contactPhone      String
  description       String
  notes             String? // technician notes - real field; the old "Save notes" button had nowhere to save to
  checklistJson     String    @default("[]") // JSON: {id,label,done,ts?}[]
  partsJson         String    @default("[]") // JSON: {id,name,partNo,qty,unitCost}[]
  timeEntriesJson   String    @default("[]") // JSON: {id,label,start,end?,minutes}[]
  signatureCaptured Boolean   @default(false)
  customerFeedback  String?
  rating            Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ===== PLANNING & SCHEDULING =====
// Resource/allocation Gantt for drivers, vehicles, and workshop bays. Real
// counterpart to the old planning/_helpers.tsx mock (buildResources/
// buildAllocations). utilisationWeek/allocationsThisWeek/conflicts are
// deliberately NOT stored here - computed live from PlanningAllocation rows
// at request time (same "can't go stale" pattern as Reminder.daysRemaining),
// scoped to whatever week the caller asks for.
model PlanningResource {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        String // Driver | Vehicle | Bay
  designation String?
  homeBase    String
  status      String   @default("Available") // Available | Allocated | Off-duty | Maintenance
  shiftStart  String   @default("06:00")
  shiftEnd    String   @default("18:00")
  skills      String? // comma-separated
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id])
  vehicleId   String?
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations PlanningAllocation[]

  @@index([companyId, type])
}

model PlanningAllocation {
  id            String           @id @default(cuid())
  companyId     String
  resourceId    String
  resource      PlanningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  type          String // Trip | Maintenance | Inspection | Loading | Unloading | Rest | Training
  title         String
  refNo         String
  startAt       DateTime
  durationHours Int
  status        String           @default("Planned") // Planned | Confirmed | Active | Completed | Cancelled
  location      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([companyId, resourceId])
  @@index([startAt])
}

// ===== LEDGER (double-entry accounting) =====
// Real counterpart to the old ledger-store.ts mock (localStorage-only
// Chart of Accounts + journal vouchers). Balances/Trial Balance/P&L/Balance
// Sheet are deliberately NOT stored - computed live from real
// LedgerJournalLine postings at request time, mirroring the exact math the
// old client-side getAccountBalance/getTrialBalance/getProfitLoss/
// getBalanceSheet selectors used (opening balance + signed Dr/Cr postings
// up to an as-of date), just server-side now.
model LedgerAccount {
  id             String   @id @default(cuid())
  companyId      String
  code           String
  name           String
  group          String // Asset | Liability | Income | Expense | Equity
  subgroup       String // Current Asset | Fixed Asset | Bank & Cash | Current Liability | Long Term Liability | Equity Capital | Operating Income | Other Income | Direct Expense | Indirect Expense | Duties & Taxes
  openingBalance Int      @default(0) // whole rupees
  openingNature  String   @default("Dr") // Dr | Cr
  isSystem       Boolean  @default(false) // protected seed account, UI blocks delete
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines LedgerJournalLine[]

  @@unique([companyId, code])
  @@index([companyId, group])
}

model LedgerJournalEntry {
  id        String   @id @default(cuid())
  companyId String
  voucherNo String
  date      DateTime
  narration String
  status    String   @default("Posted") // Draft | Posted
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines LedgerJournalLine[]

  @@unique([companyId, voucherNo])
  @@index([companyId, date])
}

model LedgerJournalLine {
  id        String             @id @default(cuid())
  entryId   String
  entry     LedgerJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount      @relation(fields: [accountId], references: [id])
  debit     Int                @default(0)
  credit    Int                @default(0)

  @@index([accountId])
  @@index([entryId])
}

// ===== TREASURY OPS =====
// Real counterpart to the old financial-ops-store.ts mock (localStorage-only
// FinOpsVoucher). One flat model covers all 7 voucher types (Advance, Add
// Money, Withdrawal, Movement, Truck Forwarding, Settlement, Recovery
// Voucher) via nullable type-specific fields, matching the original TS
// union-of-optionals shape. Standalone from the double-entry Journal (not
// auto-posted to LedgerJournalEntry) - same scope boundary as Expenses/
// Financial Services elsewhere in this app.
model TreasuryVoucher {
  id            String   @id @default(cuid())
  companyId     String
  type          String // Advance | Add Money | Withdrawal | Movement | Truck Forwarding | Settlement | Recovery Voucher
  number        String
  party         String
  amount        Int
  mode          String // Cash | UPI | Bank | NEFT | RTGS | Cheque | Card
  reference     String?
  date          DateTime
  status        String   @default("Draft") // Draft | Pending | Approved | Rejected
  against       String?
  fromAccount   String? // Movement only
  toAccount     String? // Movement only
  vehicle       String? // Truck Forwarding only
  vendor        String? // Truck Forwarding only
  lrNumber      String? // Truck Forwarding only
  fromCity      String? // Truck Forwarding only
  toCity        String? // Truck Forwarding only
  totalAdvance  Int? // Settlement only
  totalExpense  Int? // Settlement only
  netPayable    Int? // Settlement only
  settledAmount Int? // Settlement only
  balance       Int? // Settlement only
  approvedBy    String? // Withdrawal only
  remarks       String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, type])
}

// ===== LEDGER: GST RETURNS =====
model LedgerGstReturn {
  id             String    @id @default(cuid())
  companyId      String
  type           String // GSTR-1 | GSTR-3B | GSTR-2B
  period         String // e.g. "Oct 2024"
  dueDate        DateTime
  filingDate     DateTime?
  status         String    @default("Draft") // Draft | Prepared | Filed | Reconciling
  taxableValue   Int       @default(0)
  outputTax      Int       @default(0)
  inputTaxCredit Int       @default(0)
  netPayable     Int       @default(0)
  matched        Int?
  mismatched     Int?
  pending        Int?
  ackNo          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, type, period])
  @@index([companyId, type])
}

model LedgerGstReconLine {
  id           String   @id @default(cuid())
  companyId    String
  vendorGstin  String
  vendorName   String
  invoiceNo    String
  invoiceDate  DateTime
  taxableValue Int
  itcClaimed   Int
  itcAsPer2B   Int
  status       String   @default("Pending") // Matched | Mismatched | Pending
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, status])
}

// ===== HR: DOCUMENT REQUESTS / ISSUANCES / RECRUITMENT (Interviews & Offers) =====
model HrDocumentRequest {
  id          String    @id @default(cuid())
  companyId   String
  empId       String
  empCode     String
  empName     String
  docType     String
  reason      String
  requestedOn DateTime
  dueDate     DateTime
  status      String    @default("Pending") // Pending | Received | Overdue | Cancelled
  receivedOn  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, status])
}

model HrIssuance {
  id           String    @id @default(cuid())
  companyId    String
  documentId   String // human-readable like ISS-2025-0001
  type         String
  category     String
  employeeId   String
  employeeName String
  designation  String
  branch       String
  status       String    @default("Draft") // Draft | Sent | Accepted | E-Signed | Expired | Revoked
  issuedBy     String
