}

model HrOfferLetter {
  id             String    @id @default(cuid())
  companyId      String
  positionId     String
  candidateId    String
  candidateName  String
  role           String
  branch         String
  offeredCTC     Int
  joiningDate    DateTime
  status         String    @default("Drafted") // Drafted | Sent | Accepted | Declined | Expired
  issuedOn       DateTime
  acceptedOn     DateTime?
  declinedOn     DateTime?
  declinedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
}

// ===== SUPERADMIN: BACKUPS =====
// Real snapshots of the SQLite database via `VACUUM INTO` (SQLite's
// built-in hot-backup primitive - safe under concurrent reads/writes,
// unlike a raw file copy). filePath points at a real .db file on disk.
// storageUsedGB is intentionally NOT stored here - it's derived from the
// real sizeMB of completed rows so it can never drift from reality.
model Backup {
  id          String    @id @default(cuid())
  companyId   String
  type        String // Full | Incremental (see route comment: both produce a full VACUUM INTO snapshot)
  status      String    @default("Running") // Running | Completed | Failed | Restored
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  sizeMB      Float     @default(0)
  durationSec Int       @default(0)
  triggeredBy String
  filePath    String?
  restoredAt  DateTime?

  @@index([companyId, status])
}

// ===== SUPERADMIN: PLATFORM AUDIT LOG =====
// Cross-tenant, so intentionally has no companyId (unlike the tenant-scoped
// AuditLog model above) and no FK to User - internal/superadmin staff
// (Anand Kumar et al, see admin-login.tsx) are a separate concept from the
// tenant User table, so actor is free text like the original mock
// AuditEntry shape, not a relation.
// Named SuperadminAuditLog (not PlatformAuditLog) to avoid colliding with
// the pre-existing, unused PlatformAuditLog/PlatformUser/BackupSnapshot
// models further down this schema - those are vestigial boilerplate from
// an earlier/different product template ("Garage Plus", per PlatformUser's
// own comment), not planning for Reanzly's Superadmin portal, so this
// intentionally does not build on them.
model SuperadminAuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  module    String
  ip        String?
  timestamp DateTime @default(now())

  @@index([module])
  @@index([actor])
}

// ===== SUPERADMIN: SETTINGS (feature flags + gateways) =====
model SuperadminFeatureFlag {
  id        String   @id @default(cuid())
  moduleId  String   @unique
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// "Test" validates the configured provider/fromAddress are present and the
// gateway is enabled - it does NOT send a real email/SMS (this app has no
// SES/Karix credentials wired up anywhere, so faking network delivery
// would be a lie; this is an honest config-completeness check instead).
model SuperadminGateway {
  id             String    @id // "email" | "sms"
  label          String
  provider       String
  fromAddress    String
  enabled        Boolean   @default(true)
  lastTestAt     DateTime?
  lastTestStatus String? // ok | fail
  updatedAt      DateTime  @updatedAt
}

model BackupSchedule {
  id                String   @id @default(cuid())
  companyId         String   @unique
  dailyEnabled      Boolean  @default(true)
  dailyTime         String   @default("02:00")
  weeklyFullEnabled Boolean  @default(true)
  weeklyDay         String   @default("Sun")
  retentionDays     Int      @default(30)
  storageCapGB      Int      @default(500)
  updatedAt         DateTime @updatedAt
}

// ===== KNOWLEDGE BASE =====
model KnowledgeArticle {
  id              String   @id @default(cuid())
  companyId       String
  slug            String
  title           String
  category        String // SOPs | Policies | Lane Playbooks | Safety | Compliance | Troubleshooting | Onboarding
  tagsJson        String   @default("[]") // JSON: string[]
  summary         String
  author          String
  authorRole      String
  publishedOn     DateTime
  updatedOn       DateTime @default(now())
  views           Int      @default(0)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
