// ===== HELPDESK =====
// Internal support-team ticketing (the Helpdesk cluster tab inside CRM).
// Deliberately a separate model from the existing SupportTicket (which is
// the customer-facing Vendor Portal's ticket model, with a required
// customerId FK, a different status vocabulary, and its own TKT numbering
// sequence) - Helpdesk tickets aren't always against a resolved Customer
// row and need SLA/team-routing/internal-note fields SupportTicket doesn't
// have. messages/activity/sla are JSON text columns, same convention as
// FieldServiceTask's checklist/parts/timeEntries.
model HelpdeskTicket {
  id             String    @id @default(cuid())
  companyId      String
  ticketId       String    @unique // display code, e.g. TKT-2841
  subject        String
  description    String
  customer       String
  customerCode   String?
  priority       String    @default("Medium") // Urgent | High | Medium | Low
  status         String    @default("New") // New | Assigned | In Progress | Waiting | Resolved | Closed
  channel        String    @default("Email") // Email | Phone | Portal | WhatsApp | In-App
  team           String    @default("Operations")
  assignee       String    @default("Unassigned")
  requester      String
  requesterEmail String    @default("-")
  category       String
  resolvedAt     DateTime?
  relatedRef     String?
  slaJson        String    @default("{}") // JSON: {responseDue,resolutionDue,firstResponseAt?,resolvedAt?}
  messagesJson   String    @default("[]") // JSON: {id,author,role,text,ts,internal?}[]
  activityJson   String    @default("[]") // JSON: {icon,label,detail,ts}[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

// ===== AUTOMATION =====
// `Automation` already existed in the schema but had zero consumers - no
// companyId (added below), no API routes, nothing in src/ ever queried it.
// The Automation module UI read entirely from mock-data.ts's AUTOMATIONS
// array instead. AutomationRunLog is new, modeled on IntegrationSyncLog's
// shape (the closest existing real "execution history" pattern) since no
// run-history concept existed for automations at all.

model Automation {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  description     String?
  trigger         String
  triggerCategory String
  conditions      String // JSON
  actions         String // JSON
  status          String    @default("Active") // Active | Paused
  lastRun         DateTime?
  runCount        Int       @default(0)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Recurring execution ("loop") - a real, durable schedule powered by the
  // existing SQLite job queue (src/lib/queue), not a fake cron label. Each
  // run re-enqueues the next occurrence via a "automation.run" job.
  scheduleEnabled         Boolean   @default(false)
  scheduleIntervalMinutes Int?
  nextRunAt               DateTime?

  runLogs AutomationRunLog[]

  @@index([companyId])
}

model AutomationRunLog {
  id                  String     @id @default(cuid())
  companyId           String
  automationId        String
  automation          Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationName      String // denormalized snapshot - survives automation rename/delete
  triggerEntity       String? // human label of what matched, e.g. "Invoice RZ-INV-02147" or "3 invoices matched"
  conditionsEvaluated String?
  result              String // Success | Failed | Unsupported
  error               String?
  notes               String? // real Rean-generated analysis text, when the "Trigger Rean Analysis" action ran
  matchedCount        Int        @default(0)
  durationMs          Int
  createdAt           DateTime   @default(now())

  @@index([companyId, createdAt])
  @@index([automationId])
}

// ===== DRIVER FIELD APP =====
// Append-only activity log (POD, fuel, expense, issue, inspection, status, notes, duty)
model DriverActivity {
  id           String   @id @default(cuid())
  driverId     String
  driverName   String?
  tripId       String?
  vehicleId    String?
  type         String // STATUS_UPDATE | FUEL_LOG | EXPENSE | ISSUE | INSPECTION | POD | CHECK_IN | CHECK_OUT | NOTE
  payload      String // JSON blob (type-specific fields)
  photoDataUrl String? // downsampled base64 JPEG (capped ~2MB)
  lat          Float?
  lng          Float?
  accuracy     Float?
  address      String?
  note         String?
  synced       Boolean  @default(true)
