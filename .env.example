# =============================================================================
# Reanzly - Environment template
# Copy to .env and fill in. Never commit the real .env.
# =============================================================================

# ---- App ----
NODE_ENV=production
PORT=3000

# ---- Frontend routing migration (B0R) ----
# Set to 1 to enable App Router paths (/app/*) and /dashboard → /app/dashboard redirect
# NEXT_PUBLIC_ROUTING_MIGRATION=1

# ---- Database (Supabase PostgreSQL) ----
# Transaction Pooler URL (port 6543) — used at runtime by the app
# Get from: Supabase → Project Settings → Database → Connection String → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Direct connection URL (port 5432) — used by Prisma migrations only
# Get from: Supabase → Project Settings → Database → Connection String → URI (Direct connection)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# Optional read replica for horizontal read scaling (prod only)
DATABASE_REPLICA_URL=

# ---- Auth (NextAuth.js v4) ----
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ---- Real-time chat service ----
CHAT_SERVICE_PORT=3003
# Shared secret for Next.js → chat-service /internal/broadcast (constant-time verified)
CHAT_INTERNAL_SECRET=generate-with-openssl-rand-base64-32

# ---- Internal platform auth ----
# Protects /api/metrics and other internal endpoints (header: x-reanzly-internal-secret)
INTERNAL_SERVICE_SECRET=generate-with-openssl-rand-base64-32

# ---- Integration webhook secrets (per provider) ----
# WEBHOOK_SECRET_TEST=your-test-hmac-secret
# WEBHOOK_SECRET_RAZORPAY=
# INTEGRATION_WEBHOOK_SECRET_STRIPE=

# ---- Object storage ----
# Local volume in dev; S3-compatible in prod
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
# S3 (prod):
# STORAGE_DRIVER=s3
# S3_BUCKET=reanzly-storage
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Rean AI (z-ai-web-dev-sdk) ----
# The SDK reads its key from the environment in production.
# ZAI_API_KEY=

# ---- Integrations (optional) ----
# EWAYBILL_API_KEY=
# FASTAG_API_KEY=
