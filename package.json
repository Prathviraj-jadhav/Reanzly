{
  "name": "reanzly",
  "version": "0.2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,chat -c blue,green \"npm:dev:web\" \"npm:dev:chat\"",
    "dev:web": "npm run dev -w @reanzly/web",
    "dev:api": "npm run dev -w @reanzly/api",
    "dev:worker": "npm run dev -w @reanzly/worker",
    "dev:chat": "npm run dev -w @reanzly/chat",
    "dev:stack": "concurrently -k -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "build:web": "npm run build -w @reanzly/web",
    "build:api": "npm run build -w @reanzly/api",
    "build": "npm run build:web && npm run build:api",
    "start": "npm run start -w @reanzly/web",
    "lint": "npm run lint -w @reanzly/web",
    "lint:seed": "npm run lint:seed -w @reanzly/web",
    "typecheck": "npm run typecheck -w @reanzly/web && npm run typecheck -w @reanzly/api && npm run typecheck -w @reanzly/worker && npm run typecheck -w @reanzly/contracts && npm run typecheck -w @reanzly/shared && npm run typecheck -w @reanzly/database && npm run typecheck -w @reanzly/auth",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "npm run db:push -w @reanzly/database",
    "db:generate": "npm run generate -w @reanzly/database",
    "db:migrate": "npm run db:migrate -w @reanzly/database",
    "db:reset": "npm run db:reset -w @reanzly/database",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@types/node": "^22",
    "concurrently": "^10.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
